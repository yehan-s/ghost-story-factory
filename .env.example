# 复制为 .env 并按需填写

# 选一：Kimi (Moonshot) - 优先使用（兼容 MOONSHOT_* 命名）
#KIMI_API_KEY=sk-xxxx
#KIMI_API_BASE=https://api.moonshot.cn/v1
#KIMI_MODEL=kimi-k2-0905-preview
#MOONSHOT_API_KEY=sk-xxxx
#MOONSHOT_API_URL=https://api.moonshot.cn/v1
#MOONSHOT_MODEL=kimi-k2-0905-preview

# 选二：OpenAI 或兼容代理
#OPENAI_API_KEY=sk-xxxx
#OPENAI_BASE_URL=https://api.openai.com/v1
#OPENAI_MODEL=gpt-4o

# LLM 超时与重试配置（可选）
# 推荐：使用渐进式超时阶梯（默认 [60, 120, 180]）
#LLM_TIMEOUTS=60,120,180  # 逗号分隔的超时阶梯（秒）
#LLM_MAX_RETRIES=2        # 最大重试次数（默认：阶梯长度-1）
#LLM_RETRY_DELAY=2.0      # 初始重试延迟（指数退避起点，秒）
#LLM_RETRY_MAX_DELAY=60.0 # 重试延迟上限（秒）

# ⚠️ 不推荐：单一固定超时（保持向后兼容，但性能差）
#LLM_TIMEOUT=180          # 固定超时（秒），会禁用渐进式超时

# 可选：Google 搜索工具（如使用）
#GOOGLE_API_KEY=...
#GOOGLE_CSE_ID=...
